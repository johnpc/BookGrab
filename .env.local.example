# MAM dynamic-seedbox session token (seed; rotations are persisted to MAM_TOKEN_FILE if set)
MAM_TOKEN=your_mam_token_here
# Optional: where rotated tokens are stored. The Docker image sets /data/mam_token.
# MAM_TOKEN_FILE=./.mam_token
TRANSMISSION_URL=http://your-transmission-server:9091/transmission/rpc
AUDIOBOOK_DESTINATION_PATH=/path/to/audiobooks
EBOOK_DESTINATION_PATH=/path/to/ebooks
