{
  "name": "bookgrab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node tests/mock/with-mock-backend.mjs next dev",
    "build": "next build",
    "start": "next start",
    "start:mock": "node tests/mock/with-mock-backend.mjs node scripts/start-standalone.mjs",
    "mock-backend": "node tests/mock/mock-backend.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "start:standalone": "node scripts/start-standalone.mjs",
    "tour": "node scripts/visual-tour.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  }
}
